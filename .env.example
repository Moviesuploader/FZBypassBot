# Required Telegram credentials
BOT_TOKEN=
API_ID=
API_HASH=
OWNER_ID=

# Optional access control: space-separated chat IDs; use chat_id:topic_id for topics
AUTH_CHATS=

# Optional behavior
AUTO_BYPASS=False
CMD_SUFFIX=
DIRECT_INDEX=
GDTOT_CRYPT=
DRIVEFIRE_CRYPT=
HUBDRIVE_CRYPT=
KATDRIVE_CRYPT=
TERA_COOKIE=
LARAVEL_SESSION=
XSRF_TOKEN=

# Container defaults (normally do not change)
PORT=8080
DATA_DIR=/app/data
